<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="formular0.Views.GamesListView"
             x:Name="Root"
             Background="#0D1117">

    <DockPanel>

        <!-- ══════════ HEADER ══════════ -->
        <Border DockPanel.Dock="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#0D1117" Offset="0"/>
                    <GradientStop Color="#1A0F2E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="28,20,28,20" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Background="#7C3AED22" CornerRadius="12" Padding="12">
                        <TextBlock Text="🎮" FontSize="28"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Game Tracker" Classes="h1"/>
                        <TextBlock Text="Sleduj svou herní sbírku" Classes="muted" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Classes="primary" Command="{Binding AddCommand}"
                        VerticalAlignment="Center" Padding="18,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="＋" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Přidat hru" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════ STATS ══════════ -->
        <Border DockPanel.Dock="Top" Margin="28,0,28,20">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                <Border Grid.Column="0" Background="#161B22" CornerRadius="12"
                        BorderBrush="#21262D" BorderThickness="1" Padding="20,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#7C3AED22" CornerRadius="8" Padding="8,6">
                                <TextBlock Text="🗂" FontSize="16"/>
                            </Border>
                            <TextBlock Text="CELKEM HER" Classes="label" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalGames}" FontSize="32"
                                   FontWeight="Bold" Foreground="#A78BFA"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#161B22" CornerRadius="12"
                        BorderBrush="#21262D" BorderThickness="1" Padding="20,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#0EA5E922" CornerRadius="8" Padding="8,6">
                                <TextBlock Text="⏱" FontSize="16"/>
                            </Border>
                            <TextBlock Text="CELKEM HODIN" Classes="label" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalHours, StringFormat='{}{0:0.#}'}"
                                       FontSize="32" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="h" FontSize="18" Foreground="#64748B"
                                       VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#161B22" CornerRadius="12"
                        BorderBrush="#21262D" BorderThickness="1" Padding="20,16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#F59E0B22" CornerRadius="8" Padding="8,6">
                                <TextBlock Text="🏆" FontSize="16"/>
                            </Border>
                            <TextBlock Text="NEJHRANĚJŠÍ" Classes="label" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TopGame}" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#FCD34D"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ══════════ SEARCH + SORT ══════════ -->
        <Border DockPanel.Dock="Top" Margin="28,0,28,16">
            <Grid ColumnDefinitions="*,Auto,220" ColumnSpacing="12">

                <Border Grid.Column="0" Background="#161B22" CornerRadius="10"
                        BorderBrush="#21262D" BorderThickness="1" Padding="14,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                                   VerticalAlignment="Center" Foreground="#4B5563" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText}"
                                 Watermark="Hledat hru nebo platformu..."
                                 Background="Transparent" BorderThickness="0"
                                 Padding="0,10" Foreground="#E5E7EB"/>
                        <Button Grid.Column="2" Classes="ghost sm" Content="✕"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="Řadit:" Classes="muted"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}"/>
            </Grid>
        </Border>

        <!-- ══════════ CHYBA DB ══════════ -->
        <Border DockPanel.Dock="Top" Margin="28,0,28,12"
                Background="#1F0909" CornerRadius="10" Padding="16,12"
                BorderBrush="#7F1D1D" BorderThickness="1"
                IsVisible="{Binding DbError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⚠" Foreground="#F87171" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DbError}" Classes="error" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══════════ ZÁHLAVÍ TABULKY ══════════ -->
        <Border DockPanel.Dock="Top" Margin="28,0,28,0"
                Background="#161B22" CornerRadius="10" Padding="20,10"
                BorderBrush="#21262D" BorderThickness="1">
            <Grid ColumnDefinitions="*,160,80,180">
                <TextBlock Grid.Column="0" Text="NÁZEV"     Classes="label"/>
                <TextBlock Grid.Column="1" Text="PLATFORMA" Classes="label"/>
                <TextBlock Grid.Column="2" Text="ROK"       Classes="label"/>
                <TextBlock Grid.Column="3" Text="AKCE"      Classes="label"/>
            </Grid>
        </Border>

        <!-- ══════════ PRÁZDNÝ STAV ══════════ -->
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center"
                    Margin="0,80,0,0" Spacing="12"
                    IsVisible="{Binding !Games.Count}">
            <TextBlock Text="🎮" FontSize="56" HorizontalAlignment="Center" Opacity="0.15"/>
            <TextBlock Text="Žádné hry" FontSize="18" FontWeight="SemiBold"
                       Foreground="#374151" HorizontalAlignment="Center"/>
            <TextBlock Classes="muted" HorizontalAlignment="Center"
                       Text="Začni přidáním své první hry kliknutím na tlačítko výše."/>
        </StackPanel>

        <!-- ══════════ SEZNAM HER ══════════ -->
        <ScrollViewer Margin="28,4,28,20">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,2" CornerRadius="10" Background="#161B22"
                                BorderBrush="#21262D" BorderThickness="1"
                                Padding="20,14">
                            <Grid ColumnDefinitions="*,160,80,180">

                                <!-- Název + poznámka -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="#F3F4F6"/>
                                    <TextBlock Text="{Binding Note}" Classes="muted"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <!-- Platforma badge -->
                                <Border Grid.Column="1" VerticalAlignment="Center"
                                        Background="#7C3AED22" CornerRadius="20"
                                        Padding="12,4" HorizontalAlignment="Left"
                                        BorderBrush="#7C3AED44" BorderThickness="1">
                                    <TextBlock Text="{Binding PlatformName}"
                                               FontSize="12" Foreground="#A78BFA"
                                               FontWeight="Medium"/>
                                </Border>

                                <!-- Rok -->
                                <TextBlock Grid.Column="2" Text="{Binding ReleaseYear}"
                                           VerticalAlignment="Center" Foreground="#6B7280"
                                           FontSize="13"/>

                                <!-- Akce -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Detail" Classes="secondary sm"
                                            Command="{Binding DataContext.DetailCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Smazat" Classes="danger sm"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
